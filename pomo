#!/bin/sh
# A small, state-file-backed pomodoro timer for i3status/swaybar.

DEFAULT_MINUTES=60
RUNNING_FORMAT='%sm'
PAUSED_FORMAT='|| %sm'
DONE_GLYPH='🍅🍅🍅'

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR must be set}"
STATE_FILE=${POMO_STATE_FILE:-"$XDG_RUNTIME_DIR/pomodoro.state"}

usage() {
    printf '%s\n' "usage: pomo {start [minutes]|toggle|stop|render|wrap}" >&2
    exit 2
}

is_number() {
    case $1 in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

load_state() {
    status=idle
    end_time=0
    remaining=0

    [ -r "$STATE_FILE" ] || return
    # The state file is written solely by this script and deliberately uses
    # shell assignments, keeping it readable and trivial to load.
    . "$STATE_FILE" 2>/dev/null || {
        status=idle
        end_time=0
        remaining=0
        return
    }

    case $status in idle|running|paused) ;; *) status=idle ;; esac
    is_number "$end_time" || end_time=0
    is_number "$remaining" || remaining=0

    case $status in
        running) [ "$end_time" -gt 0 ] || status=idle ;;
        paused) [ "$remaining" -gt 0 ] || status=idle ;;
    esac
}

write_state() {
    umask 077
    temp_file="$STATE_FILE.$$.tmp"
    {
        printf 'status=%s\n' "$status"
        printf 'end_time=%s\n' "$end_time"
        printf 'remaining=%s\n' "$remaining"
    } >"$temp_file" || exit 1
    mv "$temp_file" "$STATE_FILE"
}

refresh_bar() {
    pkill -USR1 i3status >/dev/null 2>&1 || :
}

render() {
    load_state
    case $status in
        running)
            now=$(date +%s)
            if [ "$now" -ge "$end_time" ]; then
                printf '%s' "$DONE_GLYPH"
            else
                seconds_left=$((end_time - now))
                minutes_left=$(((seconds_left + 59) / 60))
                # The format strings are intentionally user-editable settings.
                printf "$RUNNING_FORMAT" "$minutes_left"
            fi
            ;;
        paused)
            minutes_left=$(((remaining + 59) / 60))
            printf "$PAUSED_FORMAT" "$minutes_left"
            ;;
    esac
}

start() {
    minutes=${1:-$DEFAULT_MINUTES}
    is_number "$minutes" && [ "$minutes" -gt 0 ] || usage

    now=$(date +%s)
    status=running
    end_time=$((now + minutes * 60))
    remaining=0
    write_state
    refresh_bar
}

toggle() {
    load_state
    now=$(date +%s)

    case $status in
        running)
            remaining=$((end_time - now))
            if [ "$remaining" -le 0 ]; then
                # A completed timer has no remaining duration to resume.
                status=idle
                end_time=0
                remaining=0
            else
                status=paused
                end_time=0
            fi
            ;;
        paused)
            status=running
            end_time=$((now + remaining))
            remaining=0
            ;;
        *)
            return
            ;;
    esac
    write_state
    refresh_bar
}

stop() {
    [ -e "$STATE_FILE" ] && command rm -f "$STATE_FILE"
    refresh_bar
}

wrap() {
    json=0
    while IFS= read -r line || [ -n "$line" ]; do
        # The i3bar header identifies the stream. Do not treat it as a plain
        # status line, and leave the opening/closing array delimiters alone.
        if [ "$json" -eq 0 ] && [ "${line#\{}" != "$line" ]; then
            json=1
            printf '%s\n' "$line"
            continue
        fi

        text=$(render)
        [ -n "$text" ] || {
            printf '%s\n' "$line"
            continue
        }

        if [ "$json" -eq 1 ]; then
            case $line in
                ',['*)
                    rest=${line#,[}
                    printf ',[{"full_text":"%s"},%s\n' "$text" "$rest"
                    ;;
                '['*)
                    rest=${line#[}
                    if [ -n "$rest" ]; then
                        printf '[{"full_text":"%s"},%s\n' "$text" "$rest"
                    else
                        printf '%s\n' "$line"
                    fi
                    ;;
                *) printf '%s\n' "$line" ;;
            esac
        else
            printf '%s%s\n' "$text" "$line"
        fi
    done
}

case ${1:-} in
    start)
        [ "$#" -le 2 ] || usage
        start "$2"
        ;;
    toggle)
        [ "$#" -eq 1 ] || usage
        toggle
        ;;
    stop)
        [ "$#" -eq 1 ] || usage
        stop
        ;;
    render)
        [ "$#" -eq 1 ] || usage
        render
        printf '\n'
        ;;
    wrap)
        [ "$#" -eq 1 ] || usage
        wrap
        ;;
    *) usage ;;
esac
