#!/bin/sh
# A small, state-file-backed pomodoro timer for i3status/swaybar.

DEFAULT_MINUTES=60
RUNNING_FORMAT='%sm'
PAUSED_FORMAT='⏸️ %sm'
DONE_GLYPH='🍅🍅🍅'

STATE_HOME=${XDG_STATE_HOME:-"${HOME:?HOME must be set}/.local/state"}
STATE_FILE=${POMO_STATE_FILE:-"$STATE_HOME/pomobar/state"}

usage() {
    printf '%s\n' "usage: pomo {toggle|stop|render|wrap}" >&2
    exit 2
}

is_number() {
    case $1 in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

load_state() {
    status=idle
    end_time=0
    remaining=0
    completed=0
    state_date=

    [ -r "$STATE_FILE" ] || return
    # The state file is written solely by this script and deliberately uses
    # shell assignments, keeping it readable and trivial to load.
    . "$STATE_FILE" 2>/dev/null || {
        status=idle
        end_time=0
        remaining=0
        completed=0
        state_date=
        return
    }

    case $status in idle|running|paused|done) ;; *) status=idle ;; esac
    is_number "$end_time" || end_time=0
    is_number "$remaining" || remaining=0
    is_number "$completed" || completed=0

    case $status in
        running) [ "$end_time" -gt 0 ] || status=idle ;;
        paused) [ "$remaining" -gt 0 ] || status=idle ;;
    esac
}

write_state() {
    umask 077
    state_dir=${STATE_FILE%/*}
    [ "$state_dir" = "$STATE_FILE" ] || mkdir -p "$state_dir" || exit 1
    temp_file="$STATE_FILE.$$.tmp"
    {
        printf 'status=%s\n' "$status"
        printf 'end_time=%s\n' "$end_time"
        printf 'remaining=%s\n' "$remaining"
        printf 'completed=%s\n' "$completed"
        printf 'state_date=%s\n' "$state_date"
    } >"$temp_file" || exit 1
    mv "$temp_file" "$STATE_FILE"
}

refresh_state() {
    load_state
    now=$(date +%s)
    today=$(date +%F)
    changed=0

    if [ "$state_date" != "$today" ]; then
        completed=0
        state_date=$today
        [ "$status" = done ] && status=idle
        changed=1
    fi

    if [ "$status" = running ] && [ "$now" -ge "$end_time" ]; then
        day_start=$(date -d "$today" +%s)
        if [ "$end_time" -ge "$day_start" ]; then
            completed=$((completed + 1))
            status=done
        else
            status=idle
        fi
        end_time=0
        remaining=0
        changed=1
    fi

    [ "$changed" -eq 0 ] || write_state
}

refresh_bar() {
    pkill -USR1 i3status >/dev/null 2>&1 || :
}

render() {
    refresh_state
    case $status in
        running)
            [ "$completed" -eq 0 ] || printf '%s ' "$completed"
            seconds_left=$((end_time - now))
            minutes_left=$(((seconds_left + 59) / 60))
            # The format strings are intentionally user-editable settings.
            printf "$RUNNING_FORMAT" "$minutes_left"
            ;;
        paused)
            minutes_left=$(((remaining + 59) / 60))
            printf "$PAUSED_FORMAT" "$minutes_left"
            ;;
        done)
            printf '%s %s' "$completed" "$DONE_GLYPH"
            ;;
    esac
}

toggle() {
    refresh_state
    now=$(date +%s)

    case $status in
        idle|done)
            status=running
            end_time=$((now + DEFAULT_MINUTES * 60))
            remaining=0
            ;;
        running)
            remaining=$((end_time - now))
            if [ "$remaining" -le 0 ]; then
                # A completed timer has no remaining duration to resume.
                status=idle
                end_time=0
                remaining=0
            else
                status=paused
                end_time=0
            fi
            ;;
        paused)
            status=running
            end_time=$((now + remaining))
            remaining=0
            ;;
        *)
            return
            ;;
    esac
    write_state
    refresh_bar
}

stop() {
    refresh_state
    status=idle
    end_time=0
    remaining=0
    write_state
    refresh_bar
}

wrap() {
    json=0
    while IFS= read -r line || [ -n "$line" ]; do
        # The i3bar header identifies the stream. Do not treat it as a plain
        # status line, and leave the opening/closing array delimiters alone.
        if [ "$json" -eq 0 ] && [ "${line#\{}" != "$line" ]; then
            json=1
            printf '%s\n' "$line"
            continue
        fi

        text=$(render)
        [ -n "$text" ] || {
            printf '%s\n' "$line"
            continue
        }

        if [ "$json" -eq 1 ]; then
            case $line in
                ',['*)
                    rest=${line#,[}
                    printf ',[{"full_text":"%s"},%s\n' "$text" "$rest"
                    ;;
                '['*)
                    rest=${line#[}
                    if [ -n "$rest" ]; then
                        printf '[{"full_text":"%s"},%s\n' "$text" "$rest"
                    else
                        printf '%s\n' "$line"
                    fi
                    ;;
                *) printf '%s\n' "$line" ;;
            esac
        else
            printf '%s%s\n' "$text" "$line"
        fi
    done
}

case ${1:-} in
    toggle)
        [ "$#" -eq 1 ] || usage
        toggle
        ;;
    stop)
        [ "$#" -eq 1 ] || usage
        stop
        ;;
    render)
        [ "$#" -eq 1 ] || usage
        render
        printf '\n'
        ;;
    wrap)
        [ "$#" -eq 1 ] || usage
        wrap
        ;;
    *) usage ;;
esac
